{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I Note",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_cipher": {
      "type": "boolean"
    },
    "open_for_all": {
      "type": "boolean"
    },
    "edit_everyone": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "login": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "login"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "text",
    "link",
    "is_cipher",
    "open_for_all",
    "edit_everyone",
    "created_at",
    "updated_at",
    "author"
  ],
  "additionalProperties": false
}