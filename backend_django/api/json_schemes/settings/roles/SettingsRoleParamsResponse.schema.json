{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "I Role Params Response",
	"oneOf": [
		{
			"$ref": "../../common/Response.schema.json"
		},
		{
			"type": "object",
			"properties": {
				"result": {
					"type": "object",
					"properties": {
						"role_params": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"format": "uuid"
								},
								"name": {
									"type": "string"
								},
								"allowed_actions": {
									"$ref": "../../common/PermissionList.schema.json"
								}
							},
							"required": [
								"id",
								"name",
								"allowed_actions"
							],
							"additionalProperties": false
						}
					},
					"required": [
						"role_params"
					],
					"additionalProperties": false
				}
			},
			"required": [
				"result"
			],
			"additionalProperties": false
		}
	]
}