{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "User Params Response",
	"type": "object",
	"properties": {
		"result": {
			"type": "object",
			"properties": {
				"user_params": {
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"format": "uuid"
						},
						"login": {
							"type": "string"
						},
						"role": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"format": "uuid"
								},
								"name": {
									"type": "string"
								}
							},
							"required": [
								"id",
								"name"
							],
							"additionalProperties": false
						}
					},
					"required": [
						"id",
						"login",
						"role"
					],
					"additionalProperties": false
				}
			},
			"required": [
				"user_params"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"result"
	],
	"additionalProperties": false
}