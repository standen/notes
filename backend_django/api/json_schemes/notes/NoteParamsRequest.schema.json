{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I Note Params Request",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "get_note_params"
          ]
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "note_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "note_link": {
              "type": "string"
            }
          },
          "required": [
            "note_link"
          ]
        }
      ]
    }
  ]
}