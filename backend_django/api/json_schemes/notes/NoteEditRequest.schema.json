{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I Note Edit Request",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "string",
      "format": "uuid"
    },
    "params": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "is_cipher": {
          "type": "boolean"
        },
        "open_for_all": {
          "type": "boolean"
        },
        "edit_everyone": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "text",
        "link",
        "is_cipher",
        "open_for_all",
        "edit_everyone"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "note_id",
    "params"
  ],
  "additionalProperties": false
}